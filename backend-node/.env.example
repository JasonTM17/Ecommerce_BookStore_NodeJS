# ── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
APP_BASE_URL=http://localhost:3000
# Comma-separated explicit origins. Wildcards are rejected in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Database ─────────────────────────────────────────────────────────────
# postgres | mysql
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bookstore
DB_USERNAME=bookstore
DB_PASSWORD=bookstore123
# Alternative: one pooled URL (Supabase). When set, its fields override the
# DB_* values above, e.g.
# DATABASE_URL=postgresql://user:pass@host:6543/postgres?sslmode=require
DATABASE_URL=
# Schema sync on boot. Defaults: true outside production, false in
# production. For a NEW empty database run `npm run db:setup` once instead of
# enabling sync at runtime.
DB_SYNCHRONIZE=true
DB_LOGGING=false
DB_SSL=false
# Connection pool bounds (pg Pool / mysql2). Small defaults suit hosted
# functions behind a shared pooler.
DB_POOL_MAX=5
DB_POOL_IDLE_TIMEOUT_MS=10000
DB_POOL_CONNECTION_TIMEOUT_MS=10000

# ── JWT ──────────────────────────────────────────────────────────────────
# Required ≥32 bytes in production; placeholder values are rejected.
JWT_SECRET=change-me-to-a-real-32-byte-plus-secret-in-production
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ── Uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_MAX_FILES=10
# ── Object storage for uploads ───────────────────────────────────────────
# local = UPLOAD_DIR on disk (dev). supabase = Supabase Storage public
# bucket (hosted). Service-role key is server-only; never expose it.
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# ── Email (leave unset to disable delivery; sends are skipped, not faked) ─
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# Dev-only email test endpoints (also requires ADMIN role)
APP_EMAIL_TEST_ENABLED=false
APP_EMAIL_ALLOWED_RECIPIENTS=

# ── Grok chatbot (disabled unless GROK_ENABLED=true AND key present) ──────
GROK_ENABLED=false
GROK_API_KEY=
GROK_API_URL=https://api.x.ai/v1/chat/completions
GROK_MODEL=grok-3
GROK_MAX_CONTEXT_MESSAGES=10

# ── VNPay (unconfigured → endpoints return "chưa được cấu hình" error) ────
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_MERCHANT_ID=
VNPAY_MERCHANT_KEY=
VNPAY_RETURN_URL=http://localhost:3001/payment/return
VNPAY_IPN_URL=http://localhost:8080/api/payments/vnpay/ipn

# ── Rate limiting ────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_LIMIT=5
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_API_LIMIT=100
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_LIMIT=200
RATE_LIMIT_PUBLIC_WINDOW_MS=60000

# ── Demo seed (dev only; passwords required explicitly in production) ────
APP_DEMO_SEED_ENABLED=false
APP_DEMO_ADMIN_PASSWORD=
APP_DEMO_MANAGER_PASSWORD=
APP_DEMO_CUSTOMER_PASSWORD=
